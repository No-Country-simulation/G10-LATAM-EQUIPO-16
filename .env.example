# IMPORTANTE: escribe los valores SIN comillas y sin espacios al final de la línea.
# Spring lee este archivo como .properties: las comillas se toman literalmente.
# Copia este archivo a ".env" en la raíz del repo (el ".env" está en .gitignore).

ORACLE_DB_USER=APP_SPRING_BOOT
ORACLE_DB_PASSWORD=TuPasswordAqui123

# Ruta absoluta al directorio donde descomprimiste el Wallet mTLS (usa "/" también en Windows)
# Windows: C:/wallet  o  C:/Users/TuUsuario/wallet
# Linux/macOS: /home/usuario/wallet  o  /Users/usuario/wallet
ORACLE_WALLET_PATH=C:/wallet

# Cadena de conexión JDBC
ORACLE_DB_URL=jdbc:oracle:thin:@communitylabdb_high?TNS_ADMIN=${ORACLE_WALLET_PATH}