{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "origen_comunidad",
    "periodo_referencia",
    "interacciones"
  ],
  "properties": {
    "origen_comunidad": {
      "type": "string",
      "pattern": "\\S"
    },
    "periodo_referencia": {
      "type": "string",
      "pattern": "\\S"
    },
    "interacciones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "autor",
          "canal",
          "tipo",
          "texto"
        ],
        "properties": {
          "autor": {
            "type": "string",
            "pattern": "\\S"
          },
          "canal": {
            "type": "string",
            "pattern": "\\S"
          },
          "tipo": {
            "type": "string",
            "pattern": "\\S"
          },
          "texto": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
